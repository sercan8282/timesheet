{
  "name": "timesheet-app",
  "version": "1.0.0",
  "description": "Timesheet Management System with Admin Portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init-db.js",
    "reset-db": "node scripts/reset-database.js",
    "export-translations": "node scripts/export-translations.js",
    "import-translations": "node scripts/import-translations.js",
    "cap:install": "npm install @capacitor/core @capacitor/cli @capacitor/android @capacitor/ios",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:android": "npx cap copy android && npx cap sync android",
    "build:ios": "npx cap copy ios && npx cap sync ios",
    "mobile:setup": "npm run cap:install && npm run cap:init && npm run cap:add:android"
  },
  "keywords": [
    "timesheet",
    "admin",
    "jwt",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.7",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
